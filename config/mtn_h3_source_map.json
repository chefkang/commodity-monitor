{
  "version": 1,
  "primary_system": "美途能进销存系统",
  "platform": "钉钉 / 氚云",
  "privacy_rule": "Only schema and mapping rules are committed. Exported business data must stay under data/internal/.",
  "trust_order": [
    "美途能进销存系统",
    "公共盘现有库存/BOM表",
    "手工模板"
  ],
  "notes": [
    "采购管理系统目前仍在搭建，暂不作为采购计划主数据源。",
    "美途能进销存系统内的采购下单、库存、入库、出库、供应商、原材料主数据优先用于采购和备货计划。"
  ],
  "export_dir": "data/internal/h3_exports",
  "normalized_dir": "data/internal/h3_normalized",
  "tables": [
    {
