      "app": "美途能进销存系统",
      "form": "原材料管理",
      "trust": "primary",
      "filename_keywords": ["原材料", "物料基础", "物料档案"],
      "required_any": ["物料编号", "物料名称"],
      "fields": {
        "material_code": ["物料编号", "物料编码"],
        "material_name": ["物料名称"],
        "material_category": ["物料类别", "原材料类别"],
        "material_spec": ["规格型号", "规格类型/材料", "规格"],
