      "app": "美途能进销存系统",
      "form": "采购下单",
      "trust": "primary",
      "filename_keywords": ["采购下单", "采购订单", "物料采购"],
      "required_any": ["采购订单编号", "物料采购", "采购总价"],
      "fields": {
        "created_at": ["创建时间"],
        "workflow_status": ["流程状态"],
